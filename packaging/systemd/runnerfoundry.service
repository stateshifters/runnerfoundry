[Unit]
Description=Runner Foundry shared control plane for self-hosted ephemeral CI runners
After=network-online.target docker.service libvirtd.service
Wants=network-online.target

[Service]
Type=notify-reload
NotifyAccess=main
User=runnerfoundry
Group=runnerfoundry
LogsDirectory=runnerfoundry
LogsDirectoryMode=0750
ExecStart=/usr/bin/runnerfoundry --config /etc/runnerfoundry/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
